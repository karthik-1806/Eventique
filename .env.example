# ============================================================
# Eventique Environment Configuration
# ============================================================

# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# FastAPI Backend URL (Optional)
# Set to enable high-throughput Python engine & AI orchestration proxy
# FASTAPI_BACKEND_URL=http://127.0.0.1:8000
# FASTAPI_TIMEOUT_MS=3000

# Backend Python Environment Variables (used by backend/app/core/config.py)
EVENTIQUE_ENV=development
EVENTIQUE_PORT=8000
EVENTIQUE_HOST=0.0.0.0
EVENTIQUE_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
EVENTIQUE_RATE_LIMIT_PER_MINUTE=60
